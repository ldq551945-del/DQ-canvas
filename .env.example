# DQ-绘图 deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional tldraw production license. It is public client configuration and must be present during the Next.js image build.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Optional image override. Use dq:local when building on the server.
# Production: use ghcr.io/dao-qin/dq@sha256:<digest> from the release evidence artifact.
DQ_IMAGE=ghcr.io/dao-qin/dq:latest

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=dq
POSTGRES_USER=dq
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
DQ_DATABASE_PROVIDER=postgres
DATABASE_URL=
DQ_DATABASE_POOL_MAX=10
# PostgreSQL connection and idle acquisition safeguards.
DQ_DATABASE_CONNECTION_TIMEOUT_MS=5000
DQ_DATABASE_IDLE_TIMEOUT_MS=30000
# Queries at or above this duration are recorded as slow samples.
DQ_DATABASE_SLOW_QUERY_MS=500
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
DQ_DATABASE_SSL=0

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
DQ_ENCRYPTION_KEY=

# Runtime paths and internal callbacks.
DQ_DATA_DIR=/app/web/.data
# Set to 0 only to disable the in-process HTTP metrics preload.
DQ_OBSERVABILITY_ENABLED=1
# Keep JSON operational logs enabled unless another collector replaces them.
DQ_OBSERVABILITY_LOGS=1
# API access logs: errors (default), all, or off.
DQ_HTTP_ACCESS_LOG=errors
DQ_HTTP_SLOW_REQUEST_MS=1000
# Warn when the filesystem containing DQ_DATA_DIR reaches this usage percentage.
DQ_MEDIA_DISK_WARN_PERCENT=85
# Optional explicit PostgreSQL client paths used by offline disaster recovery.
DQ_PG_DUMP_PATH=pg_dump
DQ_PG_RESTORE_PATH=pg_restore
DQ_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
DQ_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
DQ_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
# Clash/Mihomo TUN Fake-IP mode maps public domains into 198.18.0.0/15.
# Enable only when the deployment intentionally uses that DNS mode.
DQ_ALLOW_FAKE_IP_DNS=0

# Optional rembg sidecar for the canvas background-removal action.
# Leave blank for standard, local, external-DB, and Baota Compose: each topology
# injects its own sidecar URL. Low-memory deployments must set an external,
# internal-only rembg service URL explicitly.
# Production: use ghcr.io/dao-qin/dq-rembg@sha256:<digest> from the release evidence artifact.
DQ_REMBG_IMAGE=ghcr.io/dao-qin/dq-rembg:latest
DQ_REMBG_URL=
DQ_REMBG_INTERNAL_TOKEN=
# Baseline model checked by /readyz. Canvas V3 tasks select from the image's
# fixed allowlist: u2net, isnet-general-use, u2net_human_seg, isnet-anime, silueta.
DQ_REMBG_MODEL=silueta
DQ_REMBG_CONCURRENCY=1
DQ_REMBG_CPUS=2.0
DQ_REMBG_MEMORY_LIMIT=5g
DQ_REMBG_ALPHA_MATTING_TILE_PIXELS=1048576
DQ_REMBG_TIMEOUT_SECONDS=120
DQ_REMBG_QUEUE_TIMEOUT_SECONDS=30
DQ_REMBG_CANCEL_TIMEOUT_MS=15000
DQ_REMBG_CANCEL_TOMBSTONE_SECONDS=600
DQ_REMBG_PORT=7000
DQ_REMBG_OMP_NUM_THREADS=2
DQ_REMBG_ONNX_INTER_OP_THREADS=1

# Billing behavior.
DQ_BILLING_ORDER_EXPIRES_MINUTES=30
# One-time installation token. Use at least 32 random characters for database initialization and the first administrator.
# Remove it from the App environment and restart after installation; never expose it to the Worker.
DQ_INSTALL_TOKEN=
# Token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
DQ_MAINTENANCE_TOKEN=
# Independent token used only by generation-worker. It must differ from DQ_MAINTENANCE_TOKEN.
DQ_WORKER_TOKEN=
# Worker polls the application endpoint. Docker Compose sets this to http://app:3000.
DQ_WORKER_API_ORIGIN=
DQ_GENERATION_WORKER_ID=
DQ_GENERATION_WORKER_INTERVAL_MS=2000
DQ_GENERATION_WORKER_LANES=2
DQ_GENERATION_WORKER_HEARTBEAT_MS=15000
DQ_GENERATION_WORKER_STALE_MS=90000
# Independent loop for persisted provider-refund and local compensation jobs.
DQ_BILLING_REFUND_WORKER_INTERVAL_MS=15000
# Optional generic generation webhook HMAC-SHA256 secret (at least 32 characters).
DQ_GENERATION_WEBHOOK_SECRET=

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
DQ_CONTENT_MODERATION_PROVIDER=manual
DQ_CONTENT_MODERATION_KEYWORDS=
DQ_CONTENT_MODERATION_URL=
DQ_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
DQ_STRIPE_SECRET_KEY=
DQ_STRIPE_WEBHOOK_SECRET=
DQ_STRIPE_API_BASE=https://api.stripe.com
DQ_STRIPE_SUCCESS_URL=
DQ_STRIPE_CANCEL_URL=
DQ_STRIPE_PAYMENT_METHOD_TYPES=
DQ_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
DQ_ALIPAY_MODE=official
DQ_ALIPAY_APP_ID=
DQ_ALIPAY_PRIVATE_KEY=
DQ_ALIPAY_PRIVATE_KEY_PATH=
DQ_ALIPAY_PUBLIC_KEY=
DQ_ALIPAY_PUBLIC_KEY_PATH=
DQ_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
DQ_ALIPAY_NOTIFY_URL=
DQ_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
DQ_WECHAT_PAY_APP_ID=
DQ_WECHAT_PAY_MCH_ID=
DQ_WECHAT_PAY_CERT_SERIAL_NO=
DQ_WECHAT_PAY_PRIVATE_KEY=
DQ_WECHAT_PAY_PRIVATE_KEY_PATH=
DQ_WECHAT_PAY_API_V3_KEY=
DQ_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
DQ_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
DQ_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
DQ_WECHAT_PAY_PLATFORM_CERTIFICATE=
DQ_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
DQ_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
DQ_WECHAT_PAY_NOTIFY_URL=
DQ_WECHAT_PAY_REFUND_NOTIFY_URL=
DQ_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
DQ_PAYPLY_CHECKOUT_URL=
DQ_PAYPLY_REFUND_URL=
DQ_PAYPLY_API_KEY=
DQ_PAYPLY_API_KEY_HEADER=
DQ_PAYPLY_MERCHANT_ID=
DQ_PAYPLY_REQUEST_METHOD=POST
DQ_PAYPLY_CONTENT_TYPE=application/json
DQ_PAYPLY_EXTRA_HEADERS=
DQ_PAYPLY_REQUEST_TEMPLATE=
DQ_PAYPLY_NOTIFY_URL=
DQ_PAYPLY_RETURN_URL=
DQ_PAYPLY_CANCEL_URL=
DQ_PAYPLY_RESULT_KIND=
DQ_PAYPLY_URL_FIELD=data.payUrl
DQ_PAYPLY_QR_FIELD=data.qrContent
DQ_PAYPLY_FORM_FIELD=data.formHtml
DQ_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
DQ_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
# Required for online PayPly payments. The callback is never accepted as the payment fact source.
DQ_PAYPLY_QUERY_URL=
DQ_PAYPLY_QUERY_STATUS_FIELD=data.status
DQ_PAYPLY_QUERY_ORDER_ID_FIELD=data.orderId
DQ_PAYPLY_QUERY_ORDER_NO_FIELD=data.orderNo
DQ_PAYPLY_QUERY_TRADE_ID_FIELD=data.tradeId
DQ_PAYPLY_QUERY_PAYMENT_ID_FIELD=data.paymentId
DQ_PAYPLY_QUERY_AMOUNT_CENTS_FIELD=data.amountCents
DQ_PAYPLY_QUERY_AMOUNT_FIELD=data.amount
DQ_PAYPLY_QUERY_CURRENCY_FIELD=data.currency
DQ_PAYPLY_QUERY_PAID_AT_FIELD=data.paidAt
DQ_PAYPLY_WEBHOOK_SECRET=
DQ_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
DQ_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
DQ_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
DQ_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
DQ_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
DQ_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
DQ_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
DQ_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
DQ_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
DQ_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
DQ_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
DQ_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
DQ_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
DQ_PAYPLY_REFUND_REQUEST_METHOD=POST
DQ_PAYPLY_REFUND_CONTENT_TYPE=application/json
DQ_PAYPLY_REFUND_EXTRA_HEADERS=
DQ_PAYPLY_REFUND_REQUEST_TEMPLATE=
DQ_PAYPLY_REFUND_ID_FIELD=data.refundId
DQ_PAYPLY_REFUND_STATUS_FIELD=data.status
DQ_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded
DQ_PAYPLY_REFUND_QUERY_URL=
DQ_PAYPLY_REFUND_QUERY_STATUS_FIELD=data.status
DQ_PAYPLY_REFUND_QUERY_ID_FIELD=data.refundId

# Generic signed callback fallback for /api/billing/webhooks/custom.
DQ_PAYMENT_WEBHOOK_SECRET=
